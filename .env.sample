POSTGRES_USER=homelab
POSTGRES_PASSWORD=homelab
POSTGRES_DB=homelab

# Opt in to the dashboard's infra-services list by pointing this at the host
# Docker socket. Mounted read-only, but grants the container read-only
# visibility into every container on the host, not just this project's —
# leave unset unless you want that.
# DOCKER_SOCK_PATH=/var/run/docker.sock
